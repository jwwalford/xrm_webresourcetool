<?xml version="1.0" encoding="utf-8"?>
<!--
  XrmToolBox Tool Library package. dotnet pack fills in $version$ with the
  assembly version of the same build, so the package and DLL always match.
-->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>webresource_generator</id>
    <version>$version$</version>
    <title>Assisted Web Resource Generator</title>
    <authors>Jono</authors>
    <owners>Jono</owners>
    <license type="expression">MIT</license>
    <copyright>Copyright (c) 2026 Jono</copyright>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://github.com/jwwalford/xrm_webresourcetool</projectUrl>
    <!-- Icon URL only, no embedded <icon>: with an embedded icon nuget.org replaces the
         icon URL with its own .../icon address, which the XrmToolBox site rejects -->
    <iconUrl>https://raw.githubusercontent.com/jwwalford/xrm_webresourcetool/main/assets/plugin-80x80.png</iconUrl>
    <summary>Generate HTML/CSS and image web resources for Dataverse.</summary>
    <description>Generate HTML/CSS and image web resources: design form banners and buttons, write custom HTML/CSS with a live preview, create icons and SVG icons, upload images, and browse existing web resources.</description>
    <releaseNotes>First release in the Tool Library.
- Tools: form banner and button designers, custom HTML/CSS editor with live preview, icon generator (PNG/ICO, 16-128 px), SVG icon creator, and image upload with resize and format conversion.
- Shared icon gallery with 78 icons in categories including hardware, buildings, IT, emojis and circled numbers.
- Resource explorer to filter, preview and save existing web resources.
- Saves create or update the web resource, add it to a solution and publish it, with a progress bar.
- Works without a connection; saving asks you to connect.</releaseNotes>
    <tags>XrmToolBox Dataverse Dynamics365 WebResources WebResource HTML CSS SVG Icons Banner</tags>
    <!-- The Tool Library checks compatibility against "XrmToolBox", not XrmToolBoxPackage -->
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <dependency id="XrmToolBox" version="1.2025.10.74" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin/$configuration$/net48/webresource_generator.dll" target="lib/net48/Plugins/" />
  </files>
</package>

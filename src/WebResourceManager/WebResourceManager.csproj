<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>WebResourceManager</RootNamespace>
    <AssemblyName>webresource_generator</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Version>1.1.0</Version>
    <!-- XrmToolBox only re-reads a plugin's name and images (Plugins\manifest.json) when the
         DLL's assembly version changes, so every build gets a new one: 1.1.<days since
         2026-01-01>.<minute of the day, UTC> -->
    <BuildDay>$([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Parse('2026-01-01'))).Days)</BuildDay>
    <BuildMinute>$([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))</BuildMinute>
    <AssemblyVersion>1.1.$(BuildDay).$(BuildMinute)</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Authors>Jono</Authors>
    <Description>Assisted Web Resource Generator: generate HTML/CSS and image web resources for Dataverse.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- dotnet pack builds the XrmToolBox Tool Library package from the nuspec; the
         package version is the assembly version of the same build, as the store requires -->
    <NuspecFile>webresource_generator.nuspec</NuspecFile>
    <NuspecProperties>version=$(AssemblyVersion);configuration=$(Configuration)</NuspecProperties>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.10.74" ExcludeAssets="runtime" />
    <!-- XrmToolBoxPackage 1.2025.10.74 was compiled against a newer connection library than its nuspec declares -->
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.9.64" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!--
    Optional: copy the plugin into a local XrmToolBox install after each build, e.g.
    dotnet build -p:XrmToolBoxPluginsPath="%AppData%\MscrmTools\XrmToolBox\Plugins"
  -->
  <Target Name="DeployToXrmToolBox" AfterTargets="Build" Condition="'$(XrmToolBoxPluginsPath)' != ''">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(XrmToolBoxPluginsPath)" />
  </Target>

</Project>
